{
  "openapi": "3.0.3",
  "info": {
    "title": "XenForo REST API",
    "description": "API endpoints for XenForo community platform, providing access to various resources such as threads, posts, users, conversations, and more.",
    "version": "2.2"
  },
  "servers": [
    {
      "url": "{baseUrl}/api",
      "description": "XenForo API base URL",
      "variables": {
        "baseUrl": {
          "default": "https://xenforo.com/community"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "XF-Api-Key"
      },
      "ApiUser": {
        "type": "apiKey",
        "in": "header",
        "name": "XF-Api-User"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "error_code"
          },
          "message": {
            "type": "string",
            "example": "Error message"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/attachments/": {
      "get": {
        "operationId": "listAttachments",
        "summary": "List all attachments",
        "responses": {
          "200": {
            "description": "List of attachments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "attachments": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAttachment",
        "summary": "Upload a new attachment",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attachment created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
